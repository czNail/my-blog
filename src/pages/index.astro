---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import ArticleTimeline from "@/components/ArticleTimeline.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { getBasePath } from "@/utils/getBasePath";
import { ui } from "@/i18n";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, SITE.postPerIndex);
---

<Layout title={ui.siteTitle} description={ui.siteDesc}>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="blog-intro">
      <p class="blog-eyebrow">NEIL CHEN / NOTES</p>
      <h1>{ui.homeTitle}<span aria-hidden="true">.</span></h1>
      <p>{ui.homeDesc}</p>
    </section>

    <section id="recent-posts" aria-label="最近发表的文章">
      <ArticleTimeline posts={recentPosts} />
    </section>

    <div class="my-8 text-center">
      <LinkButton href={getBasePath("/posts/")}>
        {ui.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", window.location.pathname);
    }
  });
</script>

<style>
  .blog-intro {
    padding: 2.25rem 0 0.5rem;
  }
  .blog-intro .blog-eyebrow {
    margin: 0 0 0.75rem;
    font: 0.7rem/1.7 var(--site-font-mono);
    color: var(--site-muted);
    letter-spacing: 0.12em;
  }
  .blog-intro h1 {
    margin: 0 0 0.9rem;
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: -0.04em;
  }
  .blog-intro h1 span {
    color: var(--site-warm);
  }
  .blog-intro > p:last-child {
    margin: 0;
    color: var(--site-muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }
</style>
