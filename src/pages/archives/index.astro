---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArticleTimeline from "@/components/ArticleTimeline.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { ui } from "@/i18n";

if (!SITE.showArchives) return Astro.redirect("/404");
const posts = getSortedPosts(await getCollection("blog"));
---

<Layout
  title={`${ui.archivesTitle} | ${ui.siteTitle}`}
  description={ui.siteDesc}
>
  <Header />
  <Main pageTitle={ui.archivesTitle} pageDesc={ui.archivesDesc}>
    <ArticleTimeline {posts} />
  </Main>
  <Footer />
</Layout>
