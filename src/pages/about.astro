---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { ui } from "@/i18n";
---

<Layout title={`${ui.aboutTitle} | ${ui.siteTitle}`} description={ui.siteDesc}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{ui.aboutTitle}</h1>
      {ui.aboutBody.map(paragraph => <p>{paragraph}</p>)}
    </section>
  </main>
  <Footer />
</Layout>
