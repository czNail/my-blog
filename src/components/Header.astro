---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";
import { getBasePath } from "@/utils/getBasePath";
import { ui } from "@/i18n";

const links = [
  { path: "posts/", label: ui.navPosts },
  { path: "tags/", label: ui.navTags },
  ...(SITE.showArchives ? [{ path: "archives/", label: ui.navArchives }] : []),
  { path: "about/", label: ui.navAbout },
  { path: "search/", label: ui.navSearch },
];
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-4 -top-full z-50 bg-background px-3 py-2 text-accent focus:top-4"
>
  跳到主要内容
</a>

<header class="app-layout">
  <div class="blog-bar">
    <a class="blog-title" href={getBasePath("/")}>{ui.siteTitle}</a>
    <nav aria-label="博客导航">
      {
        links.map(({ path, label }) => {
          const href = getBasePath(path);
          return (
            <a href={href} aria-current={isCurrent(href) ? "location" : undefined}>
              {label}
            </a>
          );
        })
      }
    </nav>
    <button
      class="theme-switch"
      type="button"
      data-site-theme
      aria-label="切换到深色主题"
      aria-pressed="false"
    >
      <IconMoon class="theme-moon" aria-hidden="true" />
      <IconSunHigh class="theme-sun" aria-hidden="true" />
    </button>
  </div>
</header>

<style>
  .blog-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.25rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .blog-title {
    font-size: 1rem;
    font-weight: 650;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin-inline-start: auto;
    color: var(--site-muted);
    font-size: 0.875rem;
  }
  nav a {
    padding-block: 0.45rem;
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .theme-switch {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--site-radius-control);
  }
  .theme-switch:hover {
    background: var(--muted);
  }
  .theme-switch svg {
    width: 1rem;
    height: 1rem;
  }
  .theme-sun,
  :global([data-theme="dark"]) .theme-moon {
    display: none;
  }
  :global([data-theme="dark"]) .theme-sun {
    display: block;
  }
  @media (max-width: 560px) {
    .blog-bar {
      flex-wrap: wrap;
    }
    .theme-switch {
      margin-inline-start: auto;
    }
    nav {
      order: 1;
      width: 100%;
      margin: 0;
    }
  }
</style>
