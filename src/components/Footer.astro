---
import type { HTMLAttributes } from "astro/types";
import { footerMarkup } from "../../vendor/site-ui/shell.mjs";
type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className } = Astro.props;
---

<div class:list={[{ "mt-auto": !noMarginTop }, className]}>
  <Fragment set:html={footerMarkup()} />
</div>
